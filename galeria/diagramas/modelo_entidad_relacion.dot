digraph MER {
graph [rankdir=LR, nodesep=0.3, ranksep=0.9, dpi=300, pad=0.3, splines=true];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [color="#4A5A78", arrowsize=0.9, penwidth=1.2, fontname="Helvetica", fontsize=9, labelfontsize=10, labelfontcolor="#7A2E2E"];
administradores [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#8A4B14"><tr><td colspan="2" bgcolor="#8A4B14"><font color="white"><b>administradores</b></font></td></tr><tr><td align="left" port="id_w"><u><b>id</b></u></td><td align="left" port="id_e"><font color="#555555">INT (PK)</font></td></tr><tr><td align="left" port="usuario_w">usuario</td><td align="left" port="usuario_e"><font color="#555555">VARCHAR(50)</font></td></tr><tr><td align="left" port="password_hash_w">password_hash</td><td align="left" port="password_hash_e"><font color="#555555">VARCHAR(255)</font></td></tr><tr><td align="left" port="nombre_completo_w">nombre_completo</td><td align="left" port="nombre_completo_e"><font color="#555555">VARCHAR(100)</font></td></tr><tr><td align="left" port="fecha_creacion_w">fecha_creacion</td><td align="left" port="fecha_creacion_e"><font color="#555555">TIMESTAMP</font></td></tr></table>>];
